	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Tests automatiques pour les réponses",
					"pm.test(\"Status code is 200\", function () {",
					"    pm.response.to.have.status(200);",
					"});",
					"",
					"pm.test(\"Response time is less than 5000ms\", function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});",
					"",
					"// Test spécifique pour l'allocation",
					"if (pm.info.requestName.includes(\"Allocation\")) {",
					"    pm.test(\"Response has required fields\", function () {",
					"        const jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('hospital_name');",
					"        pm.expect(jsonData).to.have.property('hospital_id');",
					"        pm.expect(jsonData).to.have.property('distance_km');",
					"        pm.expect(jsonData).to.have.property('specialty');",
					"        pm.expect(jsonData).to.have.property('available_beds');",
					"        pm.expect(jsonData).to.have.property('estimated_time_minutes');",
					"    });",
					"}",
					"",
					"// Test pour les endpoints de santé",
					"if (pm.info.requestName.includes(\"Health\")) {",
					"    pm.test(\"Health check response is valid\", function () {",
					"        pm.expect(pm.response.text()).to.include(\"opérationnel\");",
					"    });",
					"}"
				]
			}
		}
