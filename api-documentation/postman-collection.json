  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Log de la requête",
          "console.log('🚀 Exécution de la requête:', pm.info.requestName);",
          "",
          "// Vérification de l'URL de base",
          "if (!pm.environment.get('baseUrl')) {",
          "    pm.environment.set('baseUrl', 'http://localhost:8080');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Tests automatiques",
          "pm.test('Status code is 200', function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "pm.test('Response time is less than 200ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(200);",
          "});",
          "",
          "pm.test('Content-Type is present', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.exist;",
          "});",
          "",
          "// Test spécifique pour l'allocation",
          "if (pm.info.requestName.includes('Allocate')) {",
          "    pm.test('Response contains hospital information', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('hospital_name');",
          "        pm.expect(jsonData).to.have.property('hospital_id');",
          "        pm.expect(jsonData).to.have.property('distance_km');",
          "        pm.expect(jsonData).to.have.property('available_beds');",
          "    });",
          "}",
          "",
          "// Test spécifique pour les statistiques patients",
          "if (pm.info.requestName.includes('Statistics')) {",
          "    pm.test('Response contains patient statistics', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('totalPatients');",
          "        pm.expect(jsonData).to.have.property('anonymizedPatients');",
          "    });",
          "}",
          "",
          "// Log de la réponse",
          "console.log('✅ Réponse reçue:', pm.response.status, pm.response.responseTime + 'ms');"
        ]
      }
    }
  ]
