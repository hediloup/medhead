{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AllocationResponse",
  "description": "Modèle de réponse d'allocation de lit d'hôpital",
  "type": "object",
  "required": [
    "hospital_name",
    "hospital_id", 
    "distance_km",
    "specialty",
    "available_beds",
    "estimated_time_minutes"
  ],
  "properties": {
    "hospital_name": {
      "type": "string",
      "description": "Nom de l'hôpital recommandé",
      "example": "Stepping Hill Hospital"
    },
    "hospital_id": {
      "type": "integer",
      "format": "int64",
      "description": "Identifiant unique de l'hôpital",
      "example": 10
    },
    "distance_km": {
      "type": "number",
      "format": "double",
      "description": "Distance en kilomètres entre le patient et l'hôpital",
      "example": 3.29,
      "minimum": 0
    },
    "specialty": {
      "type": "string",
      "description": "Spécialité médicale de la demande",
      "example": "Cardiology"
    },
    "available_beds": {
      "type": "integer",
      "description": "Nombre de lits disponibles après allocation",
      "example": 31,
      "minimum": 0
    },
    "estimated_time_minutes": {
      "type": "integer",
      "description": "Temps estimé d'arrivée en minutes",
      "example": 4,
      "minimum": 0
    },
    "hospital_latitude": {
      "type": "number",
      "format": "double",
      "description": "Latitude de l'hôpital recommandé",
      "example": 53.3969,
      "minimum": -90,
      "maximum": 90
    },
    "hospital_longitude": {
      "type": "number",
      "format": "double", 
      "description": "Longitude de l'hôpital recommandé",
      "example": -2.1333,
      "minimum": -180,
      "maximum": 180
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "hospital_name": "Stepping Hill Hospital",
      "hospital_id": 10,
      "distance_km": 3.29,
      "specialty": "Cardiology",
      "available_beds": 31,
      "estimated_time_minutes": 4,
      "hospital_latitude": 53.3969,
      "hospital_longitude": -2.1333,
      "description": "Réponse d'allocation réussie pour cardiologie"
    },
    {
      "hospital_name": "The Alexandra Hospital",
      "hospital_id": 67,
      "distance_km": 1.86,
      "specialty": "Dermatology",
      "available_beds": 4,
      "estimated_time_minutes": 2,
      "hospital_latitude": 53.3969,
      "hospital_longitude": -2.1333,
      "description": "Réponse d'allocation pour dermatologie"
    },
    {
      "hospital_name": "Manchester Royal Infirmary",
      "hospital_id": 7,
      "distance_km": 8.39,
      "specialty": "Emergency",
      "available_beds": 34,
      "estimated_time_minutes": 10,
      "hospital_latitude": 53.3969,
      "hospital_longitude": -2.1333,
      "description": "Réponse d'allocation pour urgence"
    }
  ]
}
